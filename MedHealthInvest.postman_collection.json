    {
      "name": "📊 Projects",
      "item": [
        {
          "name": "Add Project (Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "projectName", "value": "Healthcare Fund Alpha", "type": "text" },
                { "key": "projectDescription", "value": "A premium healthcare investment opportunity", "type": "text" },
                { "key": "targetAmount", "value": "500000", "type": "text" },
                { "key": "roi", "value": "12", "type": "text" },
                { "key": "duration", "value": "6", "type": "text" },
                { "key": "projectCategory", "value": "Healthcare", "type": "text" },
                { "key": "projectType", "value": "Standard", "type": "text" },
                { "key": "minInvestmentAmount", "value": "1000", "type": "text" },
                { "key": "projectImages", "type": "file", "src": "" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/project/add",
              "host": ["{{baseUrl}}"],
              "path": ["api", "project", "add"]
            }
          }
        },
        {
          "name": "Edit Project (Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "projectName", "value": "Updated Project Name", "type": "text" },
                { "key": "roi", "value": "15", "type": "text" },
                { "key": "projectImages", "type": "file", "src": "" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/project/edit/{{projectId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "project", "edit", "{{projectId}}"]
            }
          }
        },
        {
          "name": "Get All Projects",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.projects && jsonData.projects.length > 0) {",
                  "    pm.collectionVariables.set('projectId', jsonData.projects[0].id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/project/all",
              "host": ["{{baseUrl}}"],
              "path": ["api", "project", "all"]
            }
          }
        },
        {
          "name": "Get Project By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/project/get/{{projectId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "project", "get", "{{projectId}}"]
            }
          }
        },
        {
          "name": "Delete Project (Admin)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/project/delete/{{projectId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "project", "delete", "{{projectId}}"]
            }
          }
        }
      ]
    },
